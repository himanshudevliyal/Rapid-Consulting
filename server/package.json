{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "dashboard",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon index.js",
    "worker": "node app/workers/email.worker.js",
    "start:all": "concurrently -n \"API,WORKER\" -c \"green,blue\" \"npm run dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:status": "node scripts/migrate.js status",
    "seed": "node scripts/seed.js up",
    "seed:down": "node scripts/seed.js down",
    "seed:status": "node scripts/seed.js status"
  },
  "author": "Vishal Gautam",
