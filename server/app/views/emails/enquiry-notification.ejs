<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Enquiry — Rapid Consulting</title>
  <style>
    body { margin: 0; padding: 0; background: #f4f6f9; font-family: Arial, sans-serif; color: #333; }
    .wrapper { max-width: 600px; margin: 32px auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .header { background: #1a3c5e; padding: 28px 32px; }
    .header h1 { margin: 0; color: #fff; font-size: 22px; }
    .header p { margin: 4px 0 0; color: #a8c4e0; font-size: 13px; }
    .body { padding: 28px 32px; }
    .badge { display: inline-block; background: #e8f0fe; color: #1a3c5e; font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; border-radius: 4px; padding: 3px 8px; margin-bottom: 20px; }
    table.details { width: 100%; border-collapse: collapse; font-size: 14px; }
    table.details tr { border-bottom: 1px solid #f0f0f0; }
    table.details tr:last-child { border-bottom: none; }
    table.details td { padding: 10px 4px; vertical-align: top; }
    table.details td:first-child { color: #666; width: 130px; font-weight: 600; white-space: nowrap; }
    .cta { margin: 28px 0 0; text-align: center; }
    .cta a { display: inline-block; background: #1a3c5e; color: #fff; text-decoration: none; border-radius: 6px; padding: 12px 28px; font-size: 14px; font-weight: 600; }
    .footer { background: #f8f9fb; padding: 16px 32px; text-align: center; font-size: 12px; color: #999; border-top: 1px solid #eee; }
  </style>
</head>
<body>
  <div class="wrapper">
    <div class="header">
      <h1>Rapid Consulting</h1>
      <p>Admin Notification</p>
    </div>
    <div class="body">
      <span class="badge">New Enquiry</span>
      <table class="details">
        <tr><td>Name</td><td><%- name %></td></tr>
        <tr><td>Phone</td><td><%- phone %></td></tr>
        <% if (email) { %><tr><td>Email</td><td><%- email %></td></tr><% } %>
        <% if (location) { %><tr><td>Location</td><td><%- location %></td></tr><% } %>
        <% if (subject) { %><tr><td>Subject</td><td><%- subject %></td></tr><% } %>
        <% if (requirement) { %><tr><td>Requirement</td><td><%- requirement %></td></tr><% } %>
        <% if (page_title) { %><tr><td>Page</td><td><%- page_title %></td></tr><% } %>
        <% if (source) { %><tr><td>Source</td><td><%- source %></td></tr><% } %>
      </table>
      <div class="cta">
        <a href="<%- admin_url %>/dashboard/enquiries">View in Dashboard →</a>
      </div>
    </div>
    <div class="footer">
      This is an automated notification from the Rapid Consulting admin system.<br/>
      Do not reply to this email.
    </div>
  </div>
</body>
</html>
